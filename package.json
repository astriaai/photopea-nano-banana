{
  "name": "photopea-nano-banana",
  "version": "2.0.0",
  "private": true,
  "description": "Astria image generation and editing plugin for Photopea",
  "author": "Astria Inc",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf assets && vite build",
    "build:preview": "rm -rf next && PLUGIN_OUT_DIR=next vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
